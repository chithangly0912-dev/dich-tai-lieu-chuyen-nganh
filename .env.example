# Copy this file to .env (in the backend/ folder, or the project root - both
# are picked up) and fill in your real DeepSeek API key.
#
# Get a key at: https://platform.deepseek.com/api_keys

DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Usually you don't need to change these:
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Max upload size accepted by the backend, in megabytes.
MAX_UPLOAD_MB=60
